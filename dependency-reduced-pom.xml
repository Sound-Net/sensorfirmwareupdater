<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.soundnet</groupId>
  <artifactId>sensor-firmware-updater</artifactId>
  <name>SoundNet Sensor Firmware Updater</name>
  <version>1.0.0</version>
  <build>
    <finalName>sensor-firmware-updater</finalName>
    <plugins>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>org.soundnet.flasher.Main</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>copy-deps</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/app/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>stage-jar</id>
            <phase>package</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <copy />
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>win</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>jpackage-app-image</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <delete />
                    <exec>
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                    </exec>
                  </target>
                </configuration>
              </execution>
              <execution>
                <id>wix-exe-installer</id>
                <phase>package</phase>
                <goals>
                  <goal>run</goal>
                </goals>
                <configuration>
                  <target>
                    <mkdir />
                    <property />
                    <condition>
                      <isset />
                    </condition>
                    <condition>
                      <available />
                    </condition>
                    <condition>
                      <not>
                        <isset />
                      </not>
                    </condition>
                    <condition>
                      <isset />
                    </condition>
                    <condition>
                      <isset />
                    </condition>
                    <condition>
                      <not>
                        <or>
                          <isset />
                          <isset />
                        </or>
                      </not>
                    </condition>
                    <exec>
                      <env />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                      <arg />
                    </exec>
                    <condition>
                      <equals />
                    </condition>
                    <condition>
                      <not>
                        <equals />
                      </not>
                    </condition>
                    <echo />
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <properties>
        <javafx.platform>win</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>mac-aarch64</id>
      <properties>
        <javafx.platform>mac-aarch64</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>mac-x86</id>
      <properties>
        <javafx.platform>mac</javafx.platform>
      </properties>
    </profile>
    <profile>
      <id>linux</id>
      <properties>
        <javafx.platform>linux</javafx.platform>
      </properties>
    </profile>
  </profiles>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.10.2</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>junit-jupiter-api</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-params</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-engine</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <gson.version>2.11.0</gson.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>22.0.2</javafx.version>
    <jserialcomm.version>2.11.4</jserialcomm.version>
    <junit.version>5.10.2</junit.version>
    <controlsfx.version>11.0.0</controlsfx.version>
    <transit.version>2.0.0</transit.version>
  </properties>
</project>
