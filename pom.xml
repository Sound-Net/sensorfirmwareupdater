<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.soundnet</groupId>
  <artifactId>sensor-firmware-updater</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>SoundNet Sensor Firmware Updater</name>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>22.0.2</javafx.version>
    <jserialcomm.version>2.11.0</jserialcomm.version>
    <transit.version>2.0.0</transit.version>
    <gson.version>2.11.0</gson.version>
    <controlsfx.version>11.0.0</controlsfx.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <!-- JavaFX ships platform-specific natives. Pick the classifier for whichever
       machine is doing the build; the Windows installer must be built on Windows. -->
  <profiles>
    <profile>
      <id>win</id>
      <activation><os><family>windows</family></os></activation>
      <properties><javafx.platform>win</javafx.platform></properties>
      <build>
        <plugins>
          <!-- Runs automatically on every "mvn package" on Windows, turning the
               staged app in target/app into self-contained builds with their
               own bundled JRE, so a researcher never needs to install Java.

               app-image is a *folder* (target/dist/app-image/...): the .exe
               launcher inside it is only a few hundred KB because it is just
               a native stub that loads the JVM from the "runtime" folder
               sitting next to it - the whole folder must be kept together
               and copied/zipped as a unit, the .exe cannot be copied out on
               its own.

               For a single .exe file that actually contains the JRE inside
               it, the app-image folder above gets packed into an installer
               by NSIS (makensis - https://nsis.sourceforge.io/, e.g. choco
               install nsis), which recursively bundles the whole folder tree
               - including the nested runtime/ JRE - into one file with no
               WiX/Burn extensions to configure. That installer .exe is large
               (100+ MB, it embeds the whole runtime) and, when double-clicked,
               installs the app to Program Files with its own copy of the JRE
               - nothing to download separately. If NSIS isn't available this
               step is skipped with a warning rather than failing the whole
               build; the app-image folder is still produced either way. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-antrun-plugin</artifactId>
            <version>3.1.0</version>
            <executions>
              <execution>
                <id>jpackage-app-image</id>
                <phase>package</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <delete dir="${project.build.directory}/dist" quiet="true"/>
                    <!-- ${java.home} is the JDK running this Maven build, so this
                         does not depend on jpackage happening to be on PATH
                         (java.home may be a JRE-only install, e.g. Eclipse's
                         bundled runtime, in which case this step fails - build
                         with a full JDK 17+ on the PATH/JAVA_HOME instead). -->
                    <exec executable="${java.home}/bin/jpackage" failonerror="true">
                      <arg value="--type"/>
                      <arg value="app-image"/>
                      <arg value="--name"/>
                      <arg value="SoundNet Firmware Updater"/>
                      <arg value="--app-version"/>
                      <arg value="${project.version}"/>
                      <arg value="--vendor"/>
                      <arg value="SoundNet"/>
                      <arg value="--input"/>
                      <arg value="${project.build.directory}/app"/>
                      <arg value="--main-jar"/>
                      <arg value="sensor-firmware-updater.jar"/>
                      <arg value="--main-class"/>
                      <arg value="org.soundnet.flasher.Main"/>
                      <arg value="--dest"/>
                      <arg value="${project.build.directory}/dist/app-image"/>
                    </exec>
                  </target>
                </configuration>
              </execution>
              <execution>
                <id>nsis-installer</id>
                <phase>package</phase>
                <goals><goal>run</goal></goals>
                <configuration>
                  <target>
                    <mkdir dir="${project.build.directory}/dist/installer"/>
                    <copy file="${project.basedir}/src/main/installer/windows-installer.nsi.template"
                          tofile="${project.build.directory}/windows-installer.nsi"
                          overwrite="true">
                      <filterset>
                        <filter token="APP_NAME" value="SoundNet Firmware Updater"/>
                        <filter token="APP_VERSION" value="${project.version}"/>
                        <filter token="APP_EXE" value="SoundNet Firmware Updater.exe"/>
                        <filter token="APP_IMAGE_DIR"
                                value="${project.build.directory}/dist/app-image/SoundNet Firmware Updater"/>
                        <filter token="OUT_FILE"
                                value="${project.build.directory}/dist/installer/SoundNetFirmwareUpdaterSetup-${project.version}.exe"/>
                      </filterset>
                    </copy>
                    <!-- choco install updates PATH in the registry, but a
                         terminal/IDE opened before that was run keeps its
                         old copy of PATH and won't see makensis until it is
                         restarted. Fall back to NSIS's default install
                         locations so this works without a restart too. -->
                    <condition property="makensis.cmd"
                               value="C:\Program Files (x86)\NSIS\makensis.exe">
                      <available file="C:\Program Files (x86)\NSIS\makensis.exe"/>
                    </condition>
                    <condition property="makensis.cmd"
                               value="C:\Program Files\NSIS\makensis.exe">
                      <available file="C:\Program Files\NSIS\makensis.exe"/>
                    </condition>
                    <condition property="makensis.cmd" value="makensis">
                      <not><isset property="makensis.cmd"/></not>
                    </condition>
                    <!-- failonerror covers makensis running and returning a
                         non-zero exit code; failifexecutionfails covers
                         makensis not being found/runnable at all (e.g. not
                         installed) - Ant treats that as a hard build failure
                         by default no matter what failonerror is set to. -->
                    <exec executable="${makensis.cmd}" failonerror="false" failifexecutionfails="false"
                          resultproperty="nsis.exit" errorproperty="nsis.err">
                      <arg value="${project.build.directory}/windows-installer.nsi"/>
                    </exec>
                    <!-- <echo>'s "if" attribute isn't supported by the Ant
                         version maven-antrun-plugin uses, so pick the message
                         with two mutually-exclusive <condition>s instead: only
                         the one whose test is true actually sets the (single-
                         assignment) property. -->
                    <condition property="nsis.message"
                               value="NSIS installer built: ${project.build.directory}/dist/installer">
                      <equals arg1="${nsis.exit}" arg2="0"/>
                    </condition>
                    <condition property="nsis.message"
                               value="WARNING: could not build the single-file installer .exe (needs NSIS's makensis on PATH or at its default install location - choco install nsis, then restart your terminal/IDE so PATH refreshes). The self-contained app-image folder in target/dist/app-image is still available and does not need Java installed either, it just has to be copied as a whole folder rather than a single file.">
                      <not><equals arg1="${nsis.exit}" arg2="0"/></not>
                    </condition>
                    <echo message="${nsis.message}"/>
                  </target>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>mac-aarch64</id>
      <activation><os><family>mac</family><arch>aarch64</arch></os></activation>
      <properties><javafx.platform>mac-aarch64</javafx.platform></properties>
    </profile>
    <profile>
      <id>mac-x86</id>
      <activation><os><family>mac</family><arch>x86_64</arch></os></activation>
      <properties><javafx.platform>mac</javafx.platform></properties>
    </profile>
    <profile>
      <id>linux</id>
      <activation><os><family>unix</family><name>Linux</name></os></activation>
      <properties><javafx.platform>linux</javafx.platform></properties>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-base</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-graphics</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
      <classifier>${javafx.platform}</classifier>
    </dependency>

    <!-- Transit theme (GPLv2 with Classpath Exception, so linking is fine here).
         Pulls in FXSkins and fxthemes transitively. -->
    <dependency>
      <groupId>com.pixelduke</groupId>
      <artifactId>transit</artifactId>
      <version>${transit.version}</version>
      <exclusions>
        <!-- Transit pulls FXSkins and ControlsFX, which still declare JavaFX 11
             (including a win-classifier jar). Letting those onto the classpath
             alongside our JavaFX ${javafx.version} mixes two runtimes and ships
             the wrong platform's natives. The JavaFX we declare above is the
             only one we want. -->
        <exclusion>
          <groupId>org.openjfx</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- ToggleSwitch. Already on the runtime classpath via Transit, but declared
         explicitly because this application uses it directly. Pinned to the
         version Transit pulls so only one ControlsFX is ever present, and its
         stale JavaFX excluded the same way. -->
    <dependency>
      <groupId>org.controlsfx</groupId>
      <artifactId>controlsfx</artifactId>
      <version>${controlsfx.version}</version>
      <exclusions>
        <exclusion>
          <groupId>org.openjfx</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
      <version>${gson.version}</version>
    </dependency>

    <dependency>
      <groupId>com.fazecast</groupId>
      <artifactId>jSerialComm</artifactId>
      <version>${jserialcomm.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>sensor-firmware-updater</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.1</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>org.soundnet.flasher.Main</mainClass>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
            </manifest>
          </archive>
        </configuration>
      </plugin>

      <!-- Collect every dependency next to the jar so jpackage can consume the
           whole directory as a classpath app-image. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>copy-deps</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/app/lib</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>stage-jar</id>
            <phase>package</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <copy file="${project.build.directory}/sensor-firmware-updater.jar"
                      todir="${project.build.directory}/app"/>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
