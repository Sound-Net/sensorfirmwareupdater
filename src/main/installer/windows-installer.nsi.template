; NSIS script for the SoundNet Firmware Updater single-file Windows installer.
;
; Why NSIS instead of jpackage's built-in "exe" type: on Windows jpackage's
; "exe" (and "msi") backends both shell out to the WiX Toolset, which needs
; the Bundle/Burn extension installed and configured. NSIS is a single small
; tool (no extensions to wire up) that recursively packs an arbitrary folder
; tree - including the deeply nested bundled JRE under app-image/runtime -
; into one self-contained installer .exe.
;
; Tokens below (the @..@ placeholders) are substituted by the Maven build
; (see the "nsis-installer" execution in pom.xml) before makensis runs on
; this file - do not fill them in by hand.

!define APPNAME "@APP_NAME@"
!define APPVERSION "@APP_VERSION@"
!define APPEXE "@APP_EXE@"
!define APPIMAGEDIR "@APP_IMAGE_DIR@"
!define APPICON "@APP_ICON@"
; Where Windows looks for the "Apps & features" entry.
!define UNINSTKEY "Software\Microsoft\Windows\CurrentVersion\Uninstall\${APPNAME}"

Name "${APPNAME}"
OutFile "@OUT_FILE@"

; Per-user install: no administrator rights needed.
;
; The audience for this is researchers on institutional laptops, who very often
; cannot elevate. "user" means Windows never shows a UAC prompt; in exchange the
; installer may only write to places the current user owns, so everything below
; stays inside $LOCALAPPDATA and HKCU.
;
; $LOCALAPPDATA\Programs is where per-user Windows applications are expected to
; live (it is what VS Code and similar use), rather than Program Files, which
; needs elevation to write to.
RequestExecutionLevel user
InstallDir "$LOCALAPPDATA\Programs\${APPNAME}"
InstallDirRegKey HKCU "Software\${APPNAME}" "InstallDir"

; Start menu and desktop shortcuts go to this user's own folders, not the
; all-users ones, which would need elevation. "current" is already the NSIS
; default; it is set explicitly so the pairing with RequestExecutionLevel user
; is obvious, and so it survives anyone adding a section that changes it.
SetShellVarContext current

SetCompressor /SOLID lzma

; The installer's and uninstaller's own icons. This script uses the classic
; NSIS UI rather than MUI2, so these are set directly rather than through
; MUI_ICON / MUI_UNICON. The installed application's icon comes from the
; launcher .exe itself, which jpackage stamps with the same .ico.
Icon "${APPICON}"
UninstallIcon "${APPICON}"

Page directory
Page instfiles

UninstPage uninstConfirm
UninstPage instfiles

Section "Install"
  SetOutPath "$INSTDIR"
  ; Recursively copies the entire app-image folder as-is, bundled JRE and all.
  File /r "${APPIMAGEDIR}\*.*"

  WriteRegStr HKCU "Software\${APPNAME}" "InstallDir" "$INSTDIR"
  WriteUninstaller "$INSTDIR\Uninstall.exe"

  ; Register with "Apps & features" so the application can be uninstalled the
  ; normal way. Under HKCU, not HKLM: a per-user install may not write HKLM, and
  ; this entry should only appear for the user who installed it. Without this
  ; the only way to uninstall would be to find Uninstall.exe by hand inside
  ; AppData.
  WriteRegStr HKCU "${UNINSTKEY}" "DisplayName" "${APPNAME}"
  WriteRegStr HKCU "${UNINSTKEY}" "DisplayVersion" "${APPVERSION}"
  WriteRegStr HKCU "${UNINSTKEY}" "Publisher" "SoundNet"
  WriteRegStr HKCU "${UNINSTKEY}" "DisplayIcon" "$INSTDIR\${APPEXE}"
  WriteRegStr HKCU "${UNINSTKEY}" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "${UNINSTKEY}" "UninstallString" '"$INSTDIR\Uninstall.exe"'
  ; Tells the Settings app this one cannot be repaired or changed, only removed.
  WriteRegDWORD HKCU "${UNINSTKEY}" "NoModify" 1
  WriteRegDWORD HKCU "${UNINSTKEY}" "NoRepair" 1

  CreateDirectory "$SMPROGRAMS\${APPNAME}"
  CreateShortcut "$SMPROGRAMS\${APPNAME}\${APPNAME}.lnk" "$INSTDIR\${APPEXE}"
  CreateShortcut "$SMPROGRAMS\${APPNAME}\Uninstall.lnk" "$INSTDIR\Uninstall.exe"
  CreateShortcut "$DESKTOP\${APPNAME}.lnk" "$INSTDIR\${APPEXE}"
SectionEnd

Section "Uninstall"
  ; Must match the install section, or the uninstaller would look for the
  ; shortcuts in the all-users folders and leave this user's behind.
  SetShellVarContext current

  Delete "$DESKTOP\${APPNAME}.lnk"
  Delete "$SMPROGRAMS\${APPNAME}\${APPNAME}.lnk"
  Delete "$SMPROGRAMS\${APPNAME}\Uninstall.lnk"
  RMDir "$SMPROGRAMS\${APPNAME}"
  RMDir /r "$INSTDIR"
  DeleteRegKey HKCU "${UNINSTKEY}"
  DeleteRegKey HKCU "Software\${APPNAME}"
SectionEnd
